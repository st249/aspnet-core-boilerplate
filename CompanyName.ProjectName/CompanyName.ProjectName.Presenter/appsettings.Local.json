{
  "ConnectionStrings": {
    "Default": "Server=localhost; Database=ProjectNameDB; User Id=sa;Password=bhpass;",
    "Readonly": "Server=localhost; Database=ProjectNameDB; User Id=sa;Password=bhpass;ApplicationIntent=ReadOnly;"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning",
        "MassTransit": "Debug"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "RabbitMq": {
    "Host": "localhost",
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest",
    "LogMessagePayload": false,
    "ClusterNodes": [
      "localhost:5681",
      "localhost:5682",
      "localhost:5683"
    ],
    "ClusterEnabled": false
  },
  "RedisCache": {
    "SingleNode": "localhost:6379",
    "ClusterNodes": [
      "localhost:6380",
      "localhost:6390",
      "localhost:6400",
      "localhost:6380",
      "localhost:6390",
      "localhost:6400"
    ],
    "ClusterEnabled": false
  },
  "Minio": {
    "Connection": "localhost:9000",
    "AccessKey": "accesskey",
    "SecretKey": "accesskey",
    "RootBucketName": "ProjectName",
    "WithSSl": true
  },
  "AllowedHosts": "*",
  "App": {
    "CorsOrigins": "http://localhost"
  }
}


